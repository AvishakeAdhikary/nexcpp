name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    name: ${{ '{{' }} matrix.os {{ '}}' }} / ${{ '{{' }} matrix.build_type {{ '}}' }}
    runs-on: ${{ '{{' }} matrix.os {{ '}}' }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        build_type: [Release, Debug]
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive

{% if 'vcpkg' in package_managers %}
      - name: Setup vcpkg
        uses: lukka/run-vcpkg@v11
        with:
          vcpkgGitCommitId: '2024.01.12'
{% endif %}

      - name: Configure
        run: cmake -S . -B build -DCMAKE_BUILD_TYPE=${{ '{{' }} matrix.build_type {{ '}}' }}{% if 'vcpkg' in package_managers %} -DCMAKE_TOOLCHAIN_FILE=${{ '{{' }} env.VCPKG_ROOT {{ '}}' }}/scripts/buildsystems/vcpkg.cmake{% endif %}

      - name: Build
        run: cmake --build build --config ${{ '{{' }} matrix.build_type {{ '}}' }} -j

      - name: Test
        run: ctest --test-dir build -C ${{ '{{' }} matrix.build_type {{ '}}' }} --output-on-failure
