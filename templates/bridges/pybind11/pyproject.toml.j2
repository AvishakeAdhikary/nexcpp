[build-system]
requires = ["scikit-build-core>=0.5", "pybind11>=2.11"]
build-backend = "scikit_build_core.build"

[project]
name = "{{ module_name }}"
version = "0.1.0"
description = "pybind11 bindings for {{ header_basename }}"
requires-python = ">=3.9"

[tool.scikit-build]
cmake.minimum-version = "3.20"
wheel.expand-macos-universal-tags = true
